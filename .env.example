# Optional local preview settings for the Move With Musto source edition.
# Defaults for brand copy, agent details, and compliance assets live in code.
# Only set these when a real endpoint, booking URL, map key, or override exists.

# Public site URL used for canonical metadata.
NEXT_PUBLIC_REAL_ESTATE_SITE_URL="https://movewithmusto.com"

# Commercial launch gate. Omit or leave false in production until the
# commercial, land, and business-opportunity listing experience is ready.
NEXT_PUBLIC_COMMERCIAL_PUBLIC="false"

# Contact and lead capture.
# Blank endpoints disable network submissions. Local clones do not default to
# live services. Set these explicitly only for an environment you operate.
NEXT_PUBLIC_INQUIRY_FORM_ACTION=""
NEXT_PUBLIC_REAL_ESTATE_UNSUBSCRIBE_ACTION=""
NEXT_PUBLIC_REAL_ESTATE_APPOINTMENT_URL=""
NEXT_PUBLIC_REAL_ESTATE_APPOINTMENT_LABEL="Book an appointment now"

# Public MLS JSON delivery.
# Leave empty for same-origin /mls files in local development and static previews.
# Production uses the canonical https://data.movewithmusto.com origin. Any different
# public HTTPS origin also requires an intentional CSP update and must serve the
# sanitized bundle under /mls/ with a narrowly scoped CORS policy.
NEXT_PUBLIC_MLS_DATA_ORIGIN=""

# Property map search.
# Use a browser key restricted to your HTTP referrers and Maps JavaScript API.
# The browser does not geocode. The map ID is separate and is required for
# Advanced Markers; it is not another API key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# Optional private MLS import coordinate enrichment.
# Use a separate private key restricted to Geocoding API and, where practical,
# the operator's server IP addresses. Never prefix this secret with NEXT_PUBLIC.
# It is read only by explicitly invoked processing code; do not commit real values.
GOOGLE_MAPS_API_KEY=""

# Optional public social links.
NEXT_PUBLIC_REAL_ESTATE_INSTAGRAM_URL=""
NEXT_PUBLIC_REAL_ESTATE_LINKEDIN_URL=""
NEXT_PUBLIC_REAL_ESTATE_FACEBOOK_URL=""
